# Скопируйте в .env и впишите ключи. Файл .env в Git НЕ коммитится.
# Достаточно ОДНОГО ключа; остальные — резерв для отказоустойчивости. Все тарифы бесплатные.

# Google AI Studio — https://aistudio.google.com/ → Get API key  (основной движок группы deep)
GEMINI_API_KEY=your_google_ai_studio_key_here
# NVIDIA NIM — https://build.nvidia.com/ → Get API Key  (резерв группы deep)
NVIDIA_API_KEY=optional_nvidia_nim_key_here
# Groq — https://console.groq.com/keys  (быстрая группа fast; лимит ~8K TPM)
GROQ_API_KEY=optional_fallback_key_here
# OpenRouter — https://openrouter.ai/keys  (аварийный резерв, модели :free)
OPENROUTER_API_KEY=optional_fallback_key_here

# Маршрутизация: 'провайдер/точный-slug' через запятую, порядок = приоритет.
# Провайдеры: gemini | nvidia | groq | openrouter | ollama. Slug передаётся в API как есть.
DEEP_MODELS=gemini/gemini-4-hydrogen,gemini/gemini-3.8-flash,gemini/gemini-3.5-flash-lite,nvidia/nvidia/nemotron-3-ultra-550b-a55b,nvidia/deepseek-ai/deepseek-v4.1-flash,openrouter/openrouter/free
FAST_MODELS=groq/qwen/qwen3.8-27b,groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash-lite

# Локальный резерв (если запущен `ollama serve`)
ENABLE_OLLAMA=true
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Необязательные настройки (значения по умолчанию)
# PASS1_GROUP=fast
# PASS1_BATCH_SIZE=5
# CRITIC_BATCH_SIZE=6
# LLM_CONCURRENCY=3
# BUDGET_MAX_STEPS=80
# BUDGET_MAX_TOKENS=600000
# BUDGET_MAX_WALL_SECONDS=1200
# ALLOWED_FAILS=2
# COOLDOWN_TIME=30
# LLM_TIMEOUT_S=120
# USE_CACHE=true
# CACHE_DIR=.cache
# CITATION_THRESHOLD=85
# ENABLE_OCR=true
