# Скопируйте в .env и впишите ключ. Файл .env в Git НЕ коммитится.
# Бесплатный ключ: https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=your_google_ai_studio_key_here
GROQ_API_KEY=optional_fallback_key_here
OPENROUTER_API_KEY=optional_fallback_key_here
PRIMARY_MODEL=gemini-3.8-flash

# Необязательные настройки
# LLM_TIMEOUT_S=90
# CITATION_THRESHOLD=85
# ENABLE_OCR=true
# CACHE_DIR=.cache
